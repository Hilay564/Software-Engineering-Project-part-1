<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- מחרוזת החיבור למסד הנתונים. Connection.cs קורא אותה לפי השם GameStoreDB -->
  <connectionStrings>
    <add name="GameStoreDB"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=GameStoreDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>

  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <!-- מאפשר להחזיר רשימות גדולות (ברירת המחדל היא 64KB בלבד) -->
        <binding maxReceivedMessageSize="10485760" />
      </basicHttpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior>
          <!-- מאפשר ל-Visual Studio לקרוא את החוזה (WSDL) כשמוסיפים Service Reference -->
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <!-- בזמן פיתוח: מציג פרטי שגיאה מלאים בצד הלקוח -->
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <protocolMapping>
      <add binding="basicHttpsBinding" scheme="https" />
    </protocolMapping>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
  </system.serviceModel>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <directoryBrowse enabled="true" />
  </system.webServer>

</configuration>
