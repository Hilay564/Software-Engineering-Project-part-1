<UserControl
    x:Class="GameStore.App.Controls.UserForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        UserForm = רכיב (UserControl) שמכיל את כל שדות המשתמש.
        משתמשים בו בשלושה דפים: הרשמה, עריכת פרופיל וניהול משתמשים (מנהל).
        ככה השדות והבדיקות כתובים פעם אחת בלבד.
        מתחת לכל שדה יש TextBlock אדום להודעת שגיאה (מוסתר כשאין שגיאה).
    -->
    <StackPanel MaxWidth="560" HorizontalAlignment="Stretch">

        <TextBox x:Name="UsernameBox" Header="שם משתמש" PlaceholderText="לדוגמה: gamer_01"
                 Style="{StaticResource FormTextBoxStyle}" FlowDirection="LeftToRight" />
        <TextBlock x:Name="UsernameError" Style="{StaticResource ErrorTextStyle}" />

        <TextBlock x:Name="PasswordHint" Margin="0,12,0,0" Visibility="Collapsed"
                   Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                   Text="שינוי סיסמה: השאר את שני שדות הסיסמה ריקים כדי לשמור על הסיסמה הנוכחית." />

        <PasswordBox x:Name="PasswordBox" Header="סיסמה" PlaceholderText="8-20 תווים, אות גדולה, אות קטנה וספרה"
                     Style="{StaticResource FormPasswordBoxStyle}" />
        <TextBlock x:Name="PasswordError" Style="{StaticResource ErrorTextStyle}" />

        <PasswordBox x:Name="ConfirmBox" Header="אימות סיסמה" PlaceholderText="הקלד את הסיסמה שוב"
                     Style="{StaticResource FormPasswordBoxStyle}" />
        <TextBlock x:Name="ConfirmError" Style="{StaticResource ErrorTextStyle}" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBox x:Name="FirstNameBox" Header="שם פרטי" Style="{StaticResource FormTextBoxStyle}" />
                <TextBlock x:Name="FirstNameError" Style="{StaticResource ErrorTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBox x:Name="LastNameBox" Header="שם משפחה" Style="{StaticResource FormTextBoxStyle}" />
                <TextBlock x:Name="LastNameError" Style="{StaticResource ErrorTextStyle}" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="EmailBox" Header="אימייל" PlaceholderText="name@mail.com" InputScope="EmailSmtpAddress"
                 Style="{StaticResource FormTextBoxStyle}" FlowDirection="LeftToRight" />
        <TextBlock x:Name="EmailError" Style="{StaticResource ErrorTextStyle}" />

        <TextBox x:Name="PhoneBox" Header="טלפון נייד" PlaceholderText="050-1234567" InputScope="TelephoneNumber"
                 Style="{StaticResource FormTextBoxStyle}" FlowDirection="LeftToRight" />
        <TextBlock x:Name="PhoneError" Style="{StaticResource ErrorTextStyle}" />

        <DatePicker x:Name="BirthDatePicker" Header="תאריך לידה" Margin="0,12,0,0" HorizontalAlignment="Stretch" />
        <TextBlock x:Name="BirthDateError" Style="{StaticResource ErrorTextStyle}" />

        <TextBlock Text="מגדר" Margin="0,12,0,0" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="MaleRadio" Content="זכר" GroupName="Gender" />
            <RadioButton x:Name="FemaleRadio" Content="נקבה" GroupName="Gender" />
        </StackPanel>
        <TextBlock x:Name="GenderError" Style="{StaticResource ErrorTextStyle}" />

        <!-- ComboBox של ערים - הרשימה נטענת משירות הרשת (טבלת Cities) -->
        <ComboBox x:Name="CityCombo" Header="עיר מגורים" PlaceholderText="בחר עיר..."
                  DisplayMemberPath="Name" Style="{StaticResource FormComboBoxStyle}" />
        <TextBlock x:Name="CityError" Style="{StaticResource ErrorTextStyle}" />

    </StackPanel>
</UserControl>
