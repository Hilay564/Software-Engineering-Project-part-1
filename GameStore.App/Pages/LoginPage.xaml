<Page
    x:Class="GameStore.App.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Style="{StaticResource PageGridStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardStyle}" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" Margin="0,40,0,0">
                <StackPanel>
                    <TextBlock Text="התחברות" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="הזן שם משתמש וסיסמה" Style="{StaticResource PageSubtitleStyle}" />

                    <TextBox x:Name="UsernameBox" Header="שם משתמש" Style="{StaticResource FormTextBoxStyle}" FlowDirection="LeftToRight" />
                    <TextBlock x:Name="UsernameError" Style="{StaticResource ErrorTextStyle}" />

                    <PasswordBox x:Name="PasswordBox" Header="סיסמה" Style="{StaticResource FormPasswordBoxStyle}" KeyDown="PasswordBox_KeyDown" />
                    <TextBlock x:Name="PasswordError" Style="{StaticResource ErrorTextStyle}" />

                    <!-- הודעה כללית: שם משתמש או סיסמה שגויים -->
                    <TextBlock x:Name="LoginError" Style="{StaticResource ErrorTextStyle}" FontSize="14" Margin="0,12,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button x:Name="LoginButton" Content="התחבר" Click="LoginButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                        <ProgressRing x:Name="Loading" Width="24" Height="24" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <TextBlock Text="עוד אין לך חשבון?" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                        <HyperlinkButton Content="להרשמה" Click="RegisterLink_Click" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
