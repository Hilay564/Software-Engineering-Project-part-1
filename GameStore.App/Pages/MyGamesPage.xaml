<Page
    x:Class="GameStore.App.Pages.MyGamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Style="{StaticResource PageGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="המשחקים שלי" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <ListView x:Name="PurchasesList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PurchasesList_ItemClick" MaxWidth="900" HorizontalAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding GameImageUrl, Converter={StaticResource ImageUrlConverter}}" Height="80" Stretch="UniformToFill" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GameTitle}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Foreground="{StaticResource SubtleTextBrush}">
                                    <Run Text="נרכש בתאריך " /><Run Text="{Binding PurchaseDate, Converter={StaticResource DateConverter}}" />
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource PriceTextStyle}"
                                       Text="{Binding PricePaid, Converter={StaticResource PriceConverter}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyPanel" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,40,0,0">
            <TextBlock Text="עוד לא קנית משחקים 🙂" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" />
            <Button Content="לקטלוג המשחקים" Click="CatalogButton_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
