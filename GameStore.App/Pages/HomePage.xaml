<Page
    x:Class="GameStore.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- דף השער: הדף הראשון שרואים. מסביר מה האפליקציה ומפנה להתחברות / הרשמה / קטלוג -->
    <Grid Style="{StaticResource PageGridStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1000">

                <!-- כרטיס פתיחה -->
                <Border Style="{StaticResource CardStyle}" Padding="40" Background="{StaticResource AccentBrush}">
                    <StackPanel>
                        <TextBlock Text="🎮 ברוכים הבאים ל-GameZone" FontSize="40" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,24" FontSize="18" Foreground="White" TextWrapping="Wrap"
                                   Text="חנות משחקי המחשב שלך: גלו משחקים חדשים, קראו עליהם ורכשו אותם בקליק. כל המשחקים שקניתם נשמרים בספרייה האישית שלכם." />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CatalogButton" Content="לקטלוג המשחקים" Click="CatalogButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Background="White" Foreground="#4C1D95" />
                            <Button x:Name="LoginButton" Content="התחברות" Click="LoginButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button x:Name="RegisterButton" Content="הרשמה" Click="RegisterButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="מה אפשר לעשות באפליקציה?" Style="{StaticResource SectionTitleStyle}" Margin="0,28,0,12" />

                <!-- שלושה כרטיסי הסבר -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="🔍" FontSize="32" />
                            <TextBlock Text="גלו משחקים" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Style="{StaticResource BodyTextStyle}"
                                       Text="עיינו בקטלוג, חפשו לפי שם וסננו לפי ז'אנר: אקשן, אסטרטגיה, ספורט ועוד." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="🛒" FontSize="32" />
                            <TextBlock Text="רכשו בקלות" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Style="{StaticResource BodyTextStyle}"
                                       Text="נרשמים פעם אחת, ואז כל משחק נקנה בלחיצת כפתור ונכנס לספרייה האישית." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="📚" FontSize="32" />
                            <TextBlock Text="הספרייה שלכם" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Style="{StaticResource BodyTextStyle}"
                                       Text="כל המשחקים שקניתם במקום אחד, עם תאריך הרכישה והמחיר ששילמתם." />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Margin="0,24,0,0" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource SubtleTextBrush}"
                           Text="רוצים לדעת עוד? בחרו 'אודות האפליקציה' בתפריט." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
