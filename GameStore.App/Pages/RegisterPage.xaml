<Page
    x:Class="GameStore.App.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GameStore.App.Controls">

    <Grid Style="{StaticResource PageGridStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardStyle}" MaxWidth="620" HorizontalAlignment="Center" Padding="32">
                <StackPanel>
                    <TextBlock Text="הרשמה" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="מלא את הפרטים כדי ליצור חשבון חדש. כל השדות הם חובה." Style="{StaticResource PageSubtitleStyle}" />

                    <!-- כל השדות נמצאים ברכיב UserForm (Controls/UserForm.xaml) -->
                    <controls:UserForm x:Name="Form" />

                    <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                        <Button x:Name="RegisterButton" Content="הירשם" Click="RegisterButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                        <ProgressRing x:Name="Loading" Width="24" Height="24" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <TextBlock Text="כבר רשום?" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                        <HyperlinkButton Content="להתחברות" Click="LoginLink_Click" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
