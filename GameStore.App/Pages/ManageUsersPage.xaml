<Page
    x:Class="GameStore.App.Pages.ManageUsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:GameStore.App.Controls">

    <!-- שינוי פרטי משתמשים על ידי המנהל: רשימה מצד אחד, טופס עריכה מהצד השני -->
    <Grid Style="{StaticResource PageGridStyle}" ColumnSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
            <TextBlock Text="ניהול משתמשים" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="בחר משתמש מהרשימה כדי לערוך את פרטיו" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <!-- רשימת המשתמשים -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="🔍 חיפוש משתמש..." TextChanged="SearchBox_TextChanged" Margin="0,0,0,8" />
                <ListView x:Name="UsersList" Grid.Row="1" SelectionMode="Single" SelectionChanged="UsersList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,6">
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="{Binding FirstName}" /> <Run Text="{Binding LastName}" />
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource SubtleTextBrush}" FontSize="13">
                                    <Run Text="{Binding Username}" /><Run Text=" • " /><Run Text="{Binding IsAdmin, Converter={StaticResource AdminTextConverter}}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- טופס העריכה -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardStyle}" Padding="28">
                <Grid>
                    <TextBlock x:Name="SelectHint" Text="← בחר משתמש מהרשימה" Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource SubtleTextBrush}" />

                    <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                        <TextBlock x:Name="EditTitle" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4" />
                        <TextBlock x:Name="JoinDateText" Foreground="{StaticResource SubtleTextBrush}" />

                        <controls:UserForm x:Name="Form" />

                        <ToggleSwitch x:Name="AdminToggle" Header="הרשאת מנהל" OnContent="מנהל" OffContent="משתמש רגיל" Margin="0,16,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button x:Name="SaveButton" Content="שמירת שינויים" Click="SaveButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                            <Button x:Name="DeleteButton" Content="🗑 מחיקת משתמש" Click="DeleteButton_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Foreground="{StaticResource ErrorBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
